# Performance optimization - skip if not interactive
status is-interactive; or return

# Only source once
if set -q FISH_CONFIG_SOURCED
    return
end
set -g FISH_CONFIG_SOURCED 1

{{- /* Input Validation: Ensure crucial variables are set */ -}}
{{- if not .chezmoi.homeDir -}}
  {{- fail "Critical Error: .chezmoi.homeDir is not set!" -}}
{{- end -}}

# Load local customizations if they exist
if test -f "$HOME/.config/fish/config.fish.local"
    source "$HOME/.config/fish/config.fish.local"
end

# SSH agent — point shells at the systemd user agent socket when available.
if not set -q SSH_AUTH_SOCK; and set -q XDG_RUNTIME_DIR; and test -S "$XDG_RUNTIME_DIR/ssh-agent.socket"
    set -gx SSH_AUTH_SOCK "$XDG_RUNTIME_DIR/ssh-agent.socket"
end

# Ensure LS_COLORS is set for fish (bridged from bash dircolors setup)
if not set -q LS_COLORS
    set -l _dircolors_cache "$HOME/.cache/shell/dircolors.sh"
    if test -f "$_dircolors_cache"
        # Extract LS_COLORS value from cached dircolors output
        set -l _val (string match -r "LS_COLORS='([^']+)'" < "$_dircolors_cache")
        if set -q _val[2]
            set -gx LS_COLORS "$_val[2]"
        end
    else if command -q dircolors
        set -gx LS_COLORS (dircolors -c 2>/dev/null | string match -r "LS_COLORS='([^']+)'" | tail -1)
    else if test (uname -s) = "Darwin"
        set -gx CLICOLOR 1
        set -gx LSCOLORS "ExFxCxDxBxegedabagacad"
    end
end

# Welcome message
set -g fish_greeting ""
set -p PATH /opt/rocm
set -p PATH $HOME/Android/Sdk/emulator
set -p PATH $HOME/Android/Sdk/platform-tools
set -p PATH $HOME/Android/Sdk/cmdline-tools/latest/bin
# Force the Android Studio emulator Qt framework to use XWayland inside Niri
set -gx QT_QPA_PLATFORM xcb
# ROCm environment setup
set -gx ROCM_PATH /opt/rocm
set -gx HIP_PATH /opt/rocm
set -gx HIP_PLATFORM amd
set -gx HIP_CLANG_PATH /opt/rocm/lib/llvm/bin
set -gx HIP_INCLUDE_PATH /opt/rocm/include
set -gx HIP_LIB_PATH /opt/rocm/lib

set -gx CPATH /opt/rocm/include $CPATH
set -gx LIBRARY_PATH /opt/rocm/lib $LIBRARY_PATH
set -gx PKG_CONFIG_PATH /opt/rocm/lib/pkgconfig $PKG_CONFIG_PATH
set -gx CMAKE_PREFIX_PATH /opt/rocm /opt/rocm/lib/cmake $CMAKE_PREFIX_PATH
